APP_NAME=PreySON
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=preyson_memes
DB_USERNAME=root
DB_PASSWORD=
# Hosted MySQL (Aiven, etc.): fill DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD from the
# provider console and point MYSQL_ATTR_SSL_CA at its downloaded CA certificate.
# Paths relative to this project directory work: MYSQL_ATTR_SSL_CA=certs/aiven-mysql-ca.pem
# MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Storage: local = files on this computer; s3 = Cloudflare R2 (see below).
STORAGE_DRIVER=local

# Cloudflare R2 (S3-compatible). Create one API token with Object Read & Write
# for both buckets, then paste the S3 credentials and account endpoint here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
# Private bucket: post images/videos, served only through signed URLs.
R2_MEDIA_BUCKET=preyson-memes
# Public bucket: avatars. Enable public access (r2.dev or a custom domain)
# and set its base URL so avatar links work.
R2_AVATARS_BUCKET=preyson-avatars
R2_AVATARS_URL=
# Optional generic s3 disk (unused by the app).
AWS_BUCKET=
AWS_URL=

VITE_APP_NAME="${APP_NAME}"
